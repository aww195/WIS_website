---
// Header — shared chrome, identical on every route. Revised to the 3 Sep
// spec (WO-4 §2.1):
//
//   [WIS icon] Wright Intel Solutions, LLC     Reps & Certs ▾  People ▾  Contact
//
// Both dropdowns are <details>/<summary> disclosures — keyboard-native,
// announced by screen readers, working with JS off. The only script is a
// click-outside / Escape close, and "only one open at a time", all
// progressive enhancement. Below 640px the panels drop into normal flow
// and claim the whole row (the WO-3 addendum bug class — the flex item is
// the <li>, so the <li> is what takes flex-basis: 100%).
import UeiCopy from './UeiCopy.astro';
import { people, href as personHref } from '../data/people';
import { UEI, SBA_SEARCH } from '../data/site';

interface Props {
  activePath: string;
}

const { activePath } = Astro.props;

// Normalise so a trailing slash never breaks the active-state match.
const norm = (p: string) => (p.endsWith('/') ? p : p + '/');
const active = norm(activePath);
const isUnder = (prefix: string) => active.startsWith(norm(prefix));
---

<header class="border-b border-rule bg-surface">
  <div class="header-grid w-full max-w-5xl mx-auto px-5 py-3 sm:px-6">
    <a href="/" class="header-brand no-underline" aria-label="Wright Intel Solutions, LLC — home">
      <img src="/assets/img/wis-icon-80.png" alt="" width="40" height="40" class="header-icon" decoding="async" />
      <span class="font-display text-lg sm:text-xl text-ink">Wright Intel Solutions, LLC</span>
    </a>

    <nav class="header-nav font-prose text-sm" aria-label="Primary">
      <ul class="nav-list">
        {/* Reps & Certs — Capabilities page, and WOSB verification at SBA. */}
        <li class="nav-item-menu">
          <details class="menu" data-menu>
            <summary class={isUnder('/capabilities/') ? 'nav-link menu-summary is-active' : 'nav-link menu-summary'}>
              Reps &amp; Certs
              <svg class="menu-caret" viewBox="0 0 12 8" aria-hidden="true" focusable="false">
                <path d="M1 1.5 6 6.5l5-5" fill="none" stroke="currentColor" stroke-width="1.6"
                      stroke-linecap="round" stroke-linejoin="round" />
              </svg>
            </summary>
            <div class="menu-panel">
              <a class="menu-item" href="/capabilities/" aria-current={isUnder('/capabilities/') ? 'page' : undefined}>
                Capabilities
              </a>
              <div class="menu-item menu-verify">
                <a href={SBA_SEARCH} target="_blank" rel="noopener">WOSB Certification — verify at SBA</a>
                <UeiCopy uei={UEI} />
                <span class="menu-hint">Copy the UEI, then paste it into SBA's search</span>
              </div>
            </div>
          </details>
        </li>

        {/* People — the label itself goes to the roster; the panel lists each person. */}
        <li class="nav-item-menu">
          <details class="menu" data-menu>
            <summary class={isUnder('/people/') ? 'nav-link menu-summary is-active' : 'nav-link menu-summary'}>
              People
              <svg class="menu-caret" viewBox="0 0 12 8" aria-hidden="true" focusable="false">
                <path d="M1 1.5 6 6.5l5-5" fill="none" stroke="currentColor" stroke-width="1.6"
                      stroke-linecap="round" stroke-linejoin="round" />
              </svg>
            </summary>
            <div class="menu-panel">
              <a class="menu-item" href="/people/" aria-current={active === '/people/' ? 'page' : undefined}>
                All people
              </a>
              {people.map((p) => (
                <a class="menu-item" href={personHref(p)} aria-current={active === personHref(p) ? 'page' : undefined}>
                  <span class="menu-role font-mono">{p.short}</span> — {p.name}
                </a>
              ))}
            </div>
          </details>
        </li>

        <li>
          <a
            href="/contact/"
            aria-current={active === '/contact/' ? 'page' : undefined}
            class={active === '/contact/' ? 'nav-link is-active' : 'nav-link'}
          >
            Contact
          </a>
        </li>
      </ul>
    </nav>
  </div>
</header>

<style>
  .header-grid {
    display: grid;
    grid-template-columns: 1fr auto;
    column-gap: 1.5rem;
    row-gap: 0.6rem;
    align-items: center;
  }
  .header-brand {
    grid-column: 1; grid-row: 1; justify-self: start;
    display: inline-flex; align-items: center; gap: 0.65rem;
    text-decoration: none;
  }
  .header-icon { width: 40px; height: 40px; border-radius: 6px; flex: none; }
  .header-nav { grid-column: 2; grid-row: 1; justify-self: end; }

  @media (max-width: 640px) {
    .header-grid { grid-template-columns: 1fr; }
    .header-brand { grid-row: 1; }
    .header-nav   { grid-column: 1; grid-row: 2; justify-self: start; width: 100%; }
    .header-icon { width: 32px; height: 32px; }
  }

  .nav-list {
    list-style: none; margin: 0; padding: 0;
    display: flex; flex-wrap: wrap; align-items: center;
    gap: 0.5rem 1.25rem;
  }

  .nav-link {
    color: var(--muted);
    text-decoration: none;
    padding: 0.15rem 0;
    border-bottom: 1px solid transparent;
    white-space: nowrap;
  }
  .nav-link:hover { color: var(--accent); }
  .nav-link.is-active { color: var(--ink); border-bottom-color: var(--signal); }

  .menu { position: relative; }
  .menu-summary {
    display: inline-flex; align-items: center; gap: 0.35rem;
    cursor: pointer; list-style: none;
  }
  .menu-summary::-webkit-details-marker { display: none; }
  .menu-caret { width: 0.6rem; height: 0.4rem; transition: transform 150ms ease-out; }
  .menu[open] .menu-caret { transform: rotate(180deg); }
  @media (prefers-reduced-motion: reduce) { .menu-caret { transition: none; } }

  .menu-panel {
    position: absolute; right: 0; top: calc(100% + 0.5rem); z-index: 20;
    min-width: 17rem;
    background: var(--surface);
    border: 1px solid var(--rule);
    border-radius: 4px;
    box-shadow: 0 8px 24px -12px rgb(0 0 0 / 0.35);
    padding: 0.35rem 0;
  }
  .menu-item {
    display: block; padding: 0.5rem 0.85rem;
    color: var(--muted); text-decoration: none;
    font-size: 0.85rem; line-height: 1.4; white-space: nowrap;
  }
  a.menu-item:hover { color: var(--accent); background: var(--ground); }
  a.menu-item[aria-current="page"] { color: var(--ink); }
  .menu-role { font-size: 0.68rem; letter-spacing: 0.08em; text-transform: uppercase; }

  .menu-verify {
    display: flex; flex-direction: column; gap: 0.3rem;
    border-top: 1px solid var(--rule); margin-top: 0.35rem; padding-top: 0.6rem;
    white-space: normal;
  }
  .menu-verify a { color: var(--muted); text-decoration: none; }
  .menu-verify a:hover { color: var(--accent); }
  .menu-hint { font-size: 0.68rem; color: color-mix(in srgb, var(--muted) 80%, transparent); line-height: 1.3; }

  /* Below 640px: panels in flow, full row (see the header comment). */
  @media (max-width: 640px) {
    .nav-item-menu { flex-basis: 100%; width: 100%; }
    .menu { display: block; }
    .menu-panel { position: static; min-width: 0; width: 100%; box-shadow: none; margin-top: 0.4rem; }
    .menu-item { white-space: normal; }
  }
</style>

<script>
  // Progressive enhancement only — the disclosures work without this.
  const menus = Array.from(document.querySelectorAll<HTMLDetailsElement>('details[data-menu]'));

  menus.forEach((m) => {
    // One open at a time: opening one closes the others.
    m.addEventListener('toggle', () => {
      if (!m.open) return;
      menus.forEach((o) => { if (o !== m && o.open) o.open = false; });
    });
  });

  document.addEventListener('click', (event) => {
    menus.forEach((m) => {
      if (m.open && !m.contains(event.target as Node)) m.open = false;
    });
  });

  document.addEventListener('keydown', (event) => {
    if (event.key !== 'Escape') return;
    menus.forEach((m) => {
      if (!m.open) return;
      m.open = false;
      m.querySelector<HTMLElement>('summary')?.focus();
    });
  });
</script>
