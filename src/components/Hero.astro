---
// Hero (OQ-2, resolved WO-5 §1.1: the movie).
//
// A short loop re-encoded from the owner-produced WIS_Hero_Movie master
// (36 MB, never in the repo) sits behind the tagline. The poster is always
// present and is what renders when: the video has not loaded yet, the
// browser cannot play either source, or the visitor prefers reduced motion.
//
// Reduced motion is honoured two ways so it works with and without JS:
//   - CSS hides the <video> under prefers-reduced-motion: reduce, leaving
//     the poster <img>;
//   - the inline script removes `autoplay` before the element can start,
//     and only calls play() when motion is allowed.
// `preload="none"` keeps the loop off the critical path — the poster paints
// first, the video streams in after.
import { TAGLINE } from '../data/site';

interface Props {
  /** Show the loop. Off renders the poster only (still a valid hero). */
  video?: boolean;
}

const { video = true } = Astro.props;

const POSTER = '/assets/media/hero-poster.webp';
const MP4 = '/assets/media/hero-loop.mp4';
const WEBM = '/assets/media/hero-loop.webm';
---
<section class="hero" aria-labelledby="hero-tagline">
  <div class="hero-media" aria-hidden="true">
    <img src={POSTER} alt="" class="hero-poster" width="1280" height="720" decoding="async" fetchpriority="high" />
    {video && (
      <video
        class="hero-video"
        muted
        loop
        playsinline
        preload="none"
        poster={POSTER}
        data-hero-video
      >
        <source src={WEBM} type="video/webm" />
        <source src={MP4} type="video/mp4" />
      </video>
    )}
  </div>
  <div class="hero-inner">
    <p class="hero-kicker font-mono">Wright Intel Solutions, LLC</p>
    <h1 id="hero-tagline" class="hero-tagline">{TAGLINE}</h1>
    <slot />
  </div>
</section>

<style>
  .hero {
    position: relative;
    margin: -2.5rem -1.25rem 0;
    padding: 4rem 1.25rem 3rem;
    border-bottom: 1px solid var(--rule);
    background: #0b1a2e; /* deep-space blue under the loop; independent of theme */
    color: #eef3f8;
    overflow: hidden;
    min-height: 22rem;
  }
  @media (min-width: 640px) {
    .hero { margin: -2.5rem -1.5rem 0; padding: 5rem 1.5rem 3.5rem; min-height: 26rem; }
  }
  .hero-media { position: absolute; inset: 0; z-index: 0; }
  .hero-poster, .hero-video {
    position: absolute; inset: 0; width: 100%; height: 100%;
    object-fit: cover; object-position: center;
  }
  .hero-video { opacity: 0; transition: opacity 600ms ease-out; }
  .hero-video.is-playing { opacity: 1; }
  /* Legibility scrim over the loop. */
  .hero-media::after {
    content: ''; position: absolute; inset: 0;
    background: linear-gradient(to right, rgb(6 14 26 / 0.86) 0%, rgb(6 14 26 / 0.62) 55%, rgb(6 14 26 / 0.30) 100%);
  }
  .hero-inner { position: relative; z-index: 2; max-width: 40rem; }
  .hero-kicker {
    margin: 0 0 0.75rem; font-size: 0.72rem; letter-spacing: 0.14em;
    text-transform: uppercase; color: #b9c7d6;
  }
  .hero-tagline {
    margin: 0; font-size: clamp(2rem, 6vw, 3.25rem); line-height: 1.08;
    color: #ffffff; text-shadow: 0 1px 2px rgb(0 0 0 / 0.35);
  }
  .hero :global(.hero-lede) { color: #d5dfe9; }

  @media (prefers-reduced-motion: reduce) {
    .hero-video { display: none; }
  }
</style>

<script>
  // Progressive enhancement: the poster is the no-JS state. Start the loop
  // only when motion is allowed, and stop it if the preference changes.
  const video = document.querySelector<HTMLVideoElement>('video[data-hero-video]');
  if (video) {
    const mq = window.matchMedia('(prefers-reduced-motion: reduce)');
    const start = () => {
      if (mq.matches) return;
      video.setAttribute('autoplay', '');
      const p = video.play();
      if (p && typeof p.catch === 'function') p.catch(() => { /* autoplay refused — poster stays */ });
    };
    video.addEventListener('playing', () => video.classList.add('is-playing'), { once: true });
    mq.addEventListener('change', () => {
      if (mq.matches) { video.pause(); video.removeAttribute('autoplay'); video.classList.remove('is-playing'); }
      else start();
    });
    start();
  }
</script>
