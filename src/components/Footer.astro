---
// Footer — shared chrome, identical on every route. Revised to the 3 Sep
// spec (WO-4 §2.2):
//
//   Wright Intel Solutions, LLC
//   Lancaster, VA
//        [in] LinkedIn
//   "Your first choice for understanding Government Intelligence Community Customers."
//
// The FR-CL contact line (tel / copy-email / LinkedIn) moved off the footer
// and lives on /contact/ only. The A-2 reserved slot stays as a
// non-rendering region.
import { LINKEDIN_COMPANY, LOCATION_SHORT, BUMPER } from '../data/site';

const year = new Date().getFullYear();
---

<footer class="border-t border-rule bg-surface mt-16">
  <div class="w-full max-w-5xl mx-auto px-5 py-8 sm:px-6 footer-stack">
    <p class="font-display text-ink m-0">Wright Intel Solutions, LLC</p>
    <p class="font-mono text-xs text-muted m-0">{LOCATION_SHORT}</p>

    <a href={LINKEDIN_COMPANY} target="_blank" rel="noopener" class="footer-linkedin">
      {/* LinkedIn glyph (Lucide, ISC). Decorative — the visible text is the label. */}
      <svg viewBox="0 0 24 24" width="16" height="16" aria-hidden="true" focusable="false"
           fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
        <path d="M16 8a6 6 0 0 1 6 6v7h-4v-7a2 2 0 0 0-2-2 2 2 0 0 0-2 2v7h-4v-7a6 6 0 0 1 6-6z"/>
        <rect width="4" height="12" x="2" y="9"/>
        <circle cx="4" cy="4" r="2"/>
      </svg>
      <span>Wright Intel Solutions, LLC on LinkedIn</span>
    </a>

    <p class="footer-bumper font-display">{BUMPER}</p>

    {/* A-2 — reserved region. Deliberately empty; renders nothing. */}

    <p class="font-mono text-xs text-muted m-0 pt-3 border-t border-rule w-full">
      © {year} Wright Intel Solutions, LLC
    </p>
  </div>
</footer>

<style>
  .footer-stack {
    display: flex; flex-direction: column; align-items: center; text-align: center;
    gap: 0.5rem;
  }
  .footer-linkedin {
    display: inline-flex; align-items: center; gap: 0.45rem;
    margin-top: 0.5rem;
    color: var(--muted); text-decoration: none; font-size: 0.85rem;
    border-bottom: 1px dotted color-mix(in srgb, var(--accent) 55%, transparent);
    padding-bottom: 1px;
  }
  .footer-linkedin:hover, .footer-linkedin:focus-visible { color: var(--accent); border-bottom-color: var(--accent); }
  .footer-bumper {
    margin: 0.75rem 0 0.5rem;
    max-width: 34rem;
    font-size: 0.95rem;
    color: var(--muted);
    font-style: italic;
    text-wrap: balance;
  }
</style>
