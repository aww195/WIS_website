---
// Footer — shared chrome, identical on every route.
//
// Carries the FR-CL contact line, the published location, and the reserved
// A-2 slot. A-2 renders NOTHING at M3 — it is an anchor point so the M4
// content lands in a decided position rather than wherever it fits. It
// emits no element with layout, no heading, and no whitespace artifact;
// see the region comment below.
import ContactLine from './ContactLine.astro';

const year = new Date().getFullYear();

// Published location. WO-1 recorded a conflict here — the old site said
// "Lancaster, VA" while superseded capability statements printed a street
// address. The capability statement published in WO-2 resolves it to the
// city form with ZIP, which is what ships.
const LOCATION = 'Lancaster, VA 22503';
---

<footer class="border-t border-rule bg-surface mt-16">
  <div class="w-full max-w-5xl mx-auto px-5 py-8 sm:px-6 flex flex-col gap-4">
    <ContactLine />

    <p class="font-mono text-xs text-muted m-0">{LOCATION}</p>

    {/* A-2 — reserved region. Deliberately empty at M3 (WO-3 §3.4).
        Rendered as a comment rather than an empty <div> so it adds no box,
        no margin, and nothing for a screen reader to land on. M4 replaces
        this comment with the component. */}
    {/* A-2 SLOT — M4 */}

    <p class="font-mono text-xs text-muted m-0 pt-2 border-t border-rule">
      © {year} Wright Intel Solutions, LLC
    </p>
  </div>
</footer>
