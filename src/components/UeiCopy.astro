---
// UeiCopy — the SAM.gov Unique Entity ID as a click-to-copy control.
//
// WO-3 §3.4 (A-5) allowed folding this into the dropdown. It is a separate
// component instead, for two reasons: the UEI is a claim that will also want
// to appear on the Capabilities page and in the M6 Organization JSON-LD, so
// it should have one home; and keeping it standalone means the copy mechanic
// is exercised in two places (here and ContactLine), which makes a
// regression in either obvious.
//
// Copy mechanic is the same one ported from the sibling's ContactLine:
// clipboard API where the context is secure, textarea + execCommand
// fallback otherwise, and dual feedback — a visible badge plus an
// aria-live region, so assistive tech gets the same confirmation as sight.
//
// The UEI is public registry data (it is how anyone verifies the firm at
// SAM.gov), so unlike an email address it is NOT obfuscated — it is rendered
// in the static HTML where a crawler should find it.

interface Props {
  /** SAM.gov Unique Entity ID. */
  uei: string;
  /** Render the "UEI" prefix label. Off inside the dropdown, where the
   *  adjacent link already supplies the context. */
  showLabel?: boolean;
}

const { uei, showLabel = true } = Astro.props;
---

<span class="uei">
  {showLabel && <span class="uei-label font-mono">UEI</span>}
  <button type="button" class="uei-value font-mono" data-uei={uei} aria-label={`Copy UEI ${uei} to clipboard`}>
    <span data-uei-display>{uei}</span>
    <span class="uei-feedback" aria-hidden="true" data-uei-feedback></span>
  </button>
  <span class="sr-only" aria-live="polite" data-uei-live></span>
</span>

<style>
  .uei {
    display: inline-flex;
    align-items: baseline;
    gap: 0.4rem;
    white-space: nowrap;
  }

  .uei-label {
    font-size: 0.65rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--muted);
  }

  /* Reset the button to read as text, not a control, while staying a
     real <button> for keyboard and screen-reader semantics. */
  .uei-value {
    font: inherit;
    font-size: 0.78rem;
    letter-spacing: 0.04em;
    color: var(--ink);
    background: transparent;
    border: 0;
    border-bottom: 1px dotted color-mix(in srgb, var(--accent) 55%, transparent);
    padding: 0 0 1px;
    cursor: pointer;
    display: inline-flex;
    align-items: baseline;
    gap: 0.4rem;
    line-height: 1.3;
  }

  .uei-value:hover,
  .uei-value:focus-visible {
    color: var(--accent);
    border-bottom-color: var(--accent);
  }

  .uei-feedback {
    font-size: 0.62rem;
    letter-spacing: 0.06em;
    color: var(--signal);
    opacity: 0;
    transition: opacity 150ms ease-out;
    pointer-events: none;
  }

  .uei-feedback.is-visible {
    opacity: 1;
  }

  @media (prefers-reduced-motion: reduce) {
    .uei-feedback { transition: none; }
  }
</style>

<script>
  // Shared with ContactLine's email copy. Kept duplicated rather than
  // extracted to src/lib at M3: two small copies with no build-order
  // coupling is cheaper to reason about than a shared module for ~20
  // lines. If a third consumer appears in M4, extract it then.
  function fallbackCopy(text: string): boolean {
    try {
      const ta = document.createElement('textarea');
      ta.value = text;
      ta.setAttribute('readonly', '');
      ta.style.position = 'fixed';
      ta.style.top = '0';
      ta.style.left = '0';
      ta.style.opacity = '0';
      document.body.appendChild(ta);
      ta.select();
      const ok = document.execCommand('copy');
      document.body.removeChild(ta);
      return ok;
    } catch {
      return false;
    }
  }

  async function copyToClipboard(text: string): Promise<boolean> {
    if (navigator.clipboard && window.isSecureContext) {
      try {
        await navigator.clipboard.writeText(text);
        return true;
      } catch {
        return fallbackCopy(text);
      }
    }
    return fallbackCopy(text);
  }

  document.querySelectorAll<HTMLButtonElement>('button[data-uei]').forEach((btn) => {
    const uei = btn.dataset.uei;
    if (!uei) return;

    const feedback = btn.querySelector<HTMLElement>('[data-uei-feedback]');
    const live = btn.parentElement?.querySelector<HTMLElement>('[data-uei-live]') ?? null;
    let resetTimer: number | null = null;

    btn.addEventListener('click', async () => {
      const ok = await copyToClipboard(uei);
      if (!ok) return;
      if (feedback) {
        feedback.textContent = '✓ copied';
        feedback.classList.add('is-visible');
      }
      if (live) live.textContent = 'UEI copied';
      if (resetTimer) window.clearTimeout(resetTimer);
      resetTimer = window.setTimeout(() => {
        if (feedback) feedback.classList.remove('is-visible');
        if (live) live.textContent = '';
      }, 1600);
    });
  });
</script>
