---
// Capabilities. Absorbs the old certifications_portfolio.html — there is
// no /certifications/ route (SRS §4, folded 3 Sep); docs/redirects.md
// points the retired URL here.
//
// The download link is live at M3 because the PDF is a real, current
// document already published at this exact key on the production site.
import BaseLayout from '../../layouts/BaseLayout.astro';

const CAPABILITY_PDF = '/assets/img/WIS_Capability_Statement.pdf';
---
<BaseLayout
  title="Capabilities"
  description="Capability statement, NAICS codes, and small-business certifications for Wright Intel Solutions, LLC."
>
  <h1 class="text-3xl sm:text-4xl">Capabilities</h1>

  <p class="mt-6">
    <a href={CAPABILITY_PDF} class="capability-link font-mono text-sm">
      Capability Statement (PDF)
    </a>
  </p>
</BaseLayout>

<style>
  .capability-link {
    color: var(--accent);
    text-decoration: none;
    border-bottom: 1px solid color-mix(in srgb, var(--accent) 45%, transparent);
    padding-bottom: 1px;
  }
  .capability-link:hover { border-bottom-color: var(--accent); }
</style>
