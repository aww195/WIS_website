# Copy to .env (gitignored). Values here are placeholders — NFR-9.

# Contact-form endpoint: the HTTP API invoke URL + route, baked into dist/
# at build time. Public by nature (it is what the browser calls).
PUBLIC_CONTACT_ENDPOINT=https://REPLACE-ME.execute-api.us-east-1.amazonaws.com/contact

# Cloudflare Turnstile site key (public). Leave unset to keep Turnstile off;
# the widget renders only when this is present (OQ-6).
# PUBLIC_TURNSTILE_SITEKEY=
